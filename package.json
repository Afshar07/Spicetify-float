{
  "name": "float-spicetify",
  "version": "1.0.0",
  "private": true,
  "description": "FLOAT — an always-on-top floating player and synced lyrics window for Spotify (Spicetify extension).",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "spicetify:install": "pnpm build && node scripts/spicetify.mjs install",
    "spicetify:uninstall": "node scripts/spicetify.mjs uninstall"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
